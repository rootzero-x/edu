APP_NAME="TISU Edu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
TRUSTED_PROXIES=127.0.0.1,::1
APP_URL=https://api.tisu.uzstudents.uz
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=uz

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

CORS_ALLOWED_ORIGINS=https://tisu.uzstudents.uz

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Zaxira: shifrlash kaliti (php artisan tisu:backup-key). Kalitni serverdan TASHQARIDA ham saqlang (parol menejeri) —
# kalitsiz Telegram'dagi zaxirani ochib bo'lmaydi. BACKUP_DIR bo'sh bo'lsa ~/tisu-backups.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=
