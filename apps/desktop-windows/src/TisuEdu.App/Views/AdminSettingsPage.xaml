<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.AdminSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels">
    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Platformaning barcha sozlamalari: matnlar, qoidalar, rollar huquqlari. «Ochiq» sozlamalar sayt, bot va ilovalarda darhol ko'rinadi."
                       Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="GroupBox" MinWidth="220" SelectedIndex="{x:Bind ViewModel.GroupIndex, Mode=TwoWay}" AutomationProperties.Name="Bo'lim" />
            <AutoSuggestBox Width="320" PlaceholderText="Kalit yoki nom bo'yicha qidirish" QueryIcon="Find"
                            Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
            <controls:StatusBanner Model="{x:Bind ViewModel}" />
            <TextBlock Text="Sozlama topilmadi." Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Setting_ItemClick"
                  ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingRow">
                    <Border Style="{StaticResource ListCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                    <Run Text="{x:Bind Key}" FontFamily="Consolas" /><Run Text=" · " /><Run Text="{x:Bind Badge}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind Preview}" Style="{StaticResource SecondaryTextStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Tag="{x:Bind}" Click="Reset_Click" ToolTipService.ToolTip="Standart qiymatga qaytarish" AutomationProperties.Name="Standart qiymat"
                                        Visibility="{x:Bind IsDefault, Converter={StaticResource InverseVisibility}}">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                </Button>
                                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</local:ViewPage>
