<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.StudentProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Padding="{StaticResource PagePadding}" Spacing="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PersonPicture Initials="{x:Bind ViewModel.Initials, Mode=OneWay}" Width="64" Height="64" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Sub, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.OpenBillingCommand}" Visibility="{x:Bind ViewModel.CanBilling, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                        <TextBlock Text="To'lovlar" />
                    </StackPanel>
                </Button>
            </Grid>
            <controls:StatusBanner Model="{x:Bind ViewModel}" />

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsStudent, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Balance, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="{x:Bind ViewModel.HasBalance, Mode=OneWay}" />
                <TextBlock Text="Guruhlar" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileGroupItem">
                            <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,4">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Border Style="{StaticResource PillStyle}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind Frozen}">
                                            <TextBlock Text="muzlatilgan" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Sub}" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="{x:Bind Schedule}" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="{x:Bind Status}" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Davomat" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Attendance, Mode=OneWay}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                <TextBlock Text="Testlar" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Quizzes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                <TextBlock Text="Sertifikatlar" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Certificates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <TextBlock Text="A'zolik tarixi" Style="{StaticResource SectionHeaderStyle}" Visibility="{x:Bind ViewModel.HasTimeline, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Timeline}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimelineItem">
                        <Grid ColumnSpacing="12" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                    <Run Text="{x:Bind Period}" /><Run Text=" · " /><Run Text="{x:Bind State}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind HasDetail}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
