<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.AssignmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Padding="{StaticResource PagePadding}" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.Sub, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Due, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            <CommandBar DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.CanManage, Mode=OneWay}">
                <AppBarButton Label="Tahrirlash" Command="{x:Bind ViewModel.EditCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Fayl biriktirish" Command="{x:Bind ViewModel.AttachCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE723;" /></AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Vazifani o'chirish" Command="{x:Bind ViewModel.DeleteCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <controls:StatusBanner Model="{x:Bind ViewModel}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.Body, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItem">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                <HyperlinkButton Tag="{x:Bind}" Click="OpenFile_Click" Padding="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Name}" />
                                    </StackPanel>
                                </HyperlinkButton>
                                <TextBlock Text="{x:Bind Size}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <Button Tag="{x:Bind}" Click="DeleteFile_Click" Visibility="{x:Bind CanDelete}" Padding="6,2" AutomationProperties.Name="Faylni o'chirish">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Border>

            <!-- O'quvchi: topshirish -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsStudent, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Mening javobim" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.MyStatus, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.MyResult, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.MyAnswer, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.MyFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItem">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                <HyperlinkButton Tag="{x:Bind}" Click="OpenFile_Click" Padding="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Name}" />
                                    </StackPanel>
                                </HyperlinkButton>
                                <TextBlock Text="{x:Bind Size}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <Button Tag="{x:Bind}" Click="DeleteFile_Click" Visibility="{x:Bind CanDelete}" Padding="6,2" AutomationProperties.Name="Faylni o'chirish">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SubmitCommand}" Visibility="{x:Bind ViewModel.CanSubmit, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE724;" FontSize="14" />
                                <TextBlock Text="Topshirish" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.AttachCommand}" Visibility="{x:Bind ViewModel.CanAttach, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE723;" FontSize="14" />
                                <TextBlock Text="Fayl biriktirish" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- O'qituvchi: topshirganlar -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CanManage, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Submissions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubmissionItem">
                            <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Status}" Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind HasBody}" />
                                        <ItemsControl ItemsSource="{x:Bind Files}" Visibility="{x:Bind HasFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FileItem">
                                                    <HyperlinkButton Tag="{x:Bind}" Click="OpenFile_Click" Padding="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                                            <TextBlock Text="{x:Bind Name}" />
                                                        </StackPanel>
                                                    </HyperlinkButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Score}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                        <Button Content="Baholash" Tag="{x:Bind}" Click="Grade_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
