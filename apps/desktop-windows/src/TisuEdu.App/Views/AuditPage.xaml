<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels">
    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox Header="Amal" MinWidth="220" ItemsSource="{x:Bind ViewModel.Actions}" SelectedIndex="{x:Bind ViewModel.ActionIndex, Mode=TwoWay}" />
            <ComboBox Header="Obyekt" MinWidth="180" ItemsSource="{x:Bind ViewModel.Entities}" SelectedIndex="{x:Bind ViewModel.EntityIndex, Mode=TwoWay}" />
            <ComboBox Header="Kim" MinWidth="200" ItemsSource="{x:Bind ViewModel.Actors}" SelectedIndex="{x:Bind ViewModel.ActorIndex, Mode=TwoWay}" />
            <CalendarDatePicker Header="Dan" Date="{x:Bind ViewModel.From, Mode=TwoWay}" DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}" />
            <CalendarDatePicker Header="Gacha" Date="{x:Bind ViewModel.To, Mode=TwoWay}" DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}" />
            <Button VerticalAlignment="Bottom" Content="Ko'rsatish" Command="{x:Bind ViewModel.ApplyCommand}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
            <controls:StatusBanner Model="{x:Bind ViewModel}" />
            <TextBlock Text="Yozuvlar topilmadi." Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AuditItem">
                    <Border Style="{StaticResource ListCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Header}" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap">
                                <Run Text="{x:Bind Action}" /><Run Text=" — " /><Run Text="{x:Bind Entity}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind Diff}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Visibility="{x:Bind HasDiff}" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind HasNote}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="4">
            <TextBlock Text="{x:Bind ViewModel.PageText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Command="{x:Bind ViewModel.PrevCommand}" IsEnabled="{x:Bind ViewModel.CanPrev, Mode=OneWay}" AutomationProperties.Name="Oldingi sahifa">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button Command="{x:Bind ViewModel.NextCommand}" IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" AutomationProperties.Name="Keyingi sahifa">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</local:ViewPage>
