<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.LessonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels"
    xmlns:models="using:TisuEdu.Core.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Padding="{StaticResource PagePadding}" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.CourseTitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Position, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            </Grid>

            <controls:StatusBanner Model="{x:Bind ViewModel}" />

            <!-- 403: kursga kirish rad etildi (sozlamalardagi matn). -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsDenied, Mode=OneWay}" Padding="32">
                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="520">
                    <FontIcon Glyph="&#xE72E;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Denied.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.Denied.Message, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Content="{x:Bind ViewModel.Denied.Button, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ContactCommand}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Bu darsda hali material yo'q." Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasBody, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Body, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>

            <TextBlock Text="{x:Bind ViewModel.MaterialsTitle, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Materials}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MaterialItem">
                        <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,8">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Host}" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{x:Bind ActionText}" Tag="{x:Bind}" Click="Material_Click"
                                            Visibility="{x:Bind HasUrl}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind IsText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,16,0,0">
                <Button Command="{x:Bind ViewModel.GoPrevCommand}" Visibility="{x:Bind ViewModel.HasPrev, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="Oldingi dars" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Command="{x:Bind ViewModel.GoNextCommand}" Visibility="{x:Bind ViewModel.HasNext, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Keyingi dars" />
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
