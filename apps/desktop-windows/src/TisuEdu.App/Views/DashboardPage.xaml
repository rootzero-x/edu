<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels"
    xmlns:models="using:TisuEdu.Core.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.DateText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />

            <controls:StatusBanner Model="{x:Bind ViewModel}" />

            <!-- Sozlash ro'yxati (faqat administratorlar; ui.setup_labels) -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasSetup, Mode=OneWay}" Margin="0,4">
                <StackPanel Spacing="6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.SetupTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SetupProgress, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <HyperlinkButton HorizontalAlignment="Right" Content="Yashirish" Command="{x:Bind ViewModel.DismissSetupCommand}" Padding="0" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.SetupText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Setup}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupStepItem">
                                <HyperlinkButton Tag="{x:Bind}" Click="Setup_Click" Padding="0,2" IsEnabled="{x:Bind local:DashboardPage.Not(Done)}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                        <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.HasUnmarked, Mode=OneWay}" Message="{x:Bind ViewModel.UnmarkedText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Ko'rish" Command="{x:Bind ViewModel.OpenUnmarkedCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <GridView ItemsSource="{x:Bind ViewModel.Stats}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Stat_ItemClick"
                      Margin="0,8,0,0" ScrollViewer.VerticalScrollMode="Disabled">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatCard">
                        <Grid Width="220" Height="104" Padding="16" ColumnSpacing="12"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Text="{x:Bind Value}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid ColumnSpacing="24" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TodayTitle, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayEmpty, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind ViewModel.HasToday, Mode=OneWay, Converter={StaticResource InverseVisibility}}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Today}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Today_ItemClick"
                              ItemContainerStyle="{StaticResource CardListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TodayItem">
                                <Border Style="{StaticResource ListCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Time}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Text="{x:Bind Topic}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind HasTopic}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                                            <Border Style="{StaticResource PillStyle}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind Cancelled}">
                                                <TextBlock Text="{x:Bind CancelledText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Marked}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.NewsTitle, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}" />
                        <HyperlinkButton Content="Hammasi" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.OpenNewsCommand}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.NewsEmpty, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind ViewModel.HasNews, Mode=OneWay, Converter={StaticResource InverseVisibility}}" />
                    <ListView ItemsSource="{x:Bind ViewModel.News}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="News_ItemClick"
                              ItemContainerStyle="{StaticResource CardListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Announcement">
                                <Border Style="{StaticResource ListCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Body}" Style="{StaticResource SecondaryTextStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
