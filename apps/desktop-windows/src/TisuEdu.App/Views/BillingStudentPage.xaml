<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.BillingStudentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Phone, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" />
            <controls:StatusBanner Model="{x:Bind ViewModel}" />

            <Border Style="{StaticResource CardStyle}" Padding="24">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Balans" Style="{StaticResource SecondaryTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.Balance, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" />
                            <Border Style="{StaticResource PillStyle}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind ViewModel.InDebt, Mode=OneWay}">
                                <TextBlock Text="qarzdor" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Info, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.GroupsText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.CanManage, Mode=OneWay}">
                        <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.AddPaymentCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="To'lov kiritish" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Content="Tuzatish / chegirma" Command="{x:Bind ViewModel.AddAdjustmentCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Oylar bo'yicha" Style="{StaticResource SectionHeaderStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Months}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Jurnal" Style="{StaticResource SectionHeaderStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Entries}">
                <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EntryItem">
                    <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,4">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Date}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Type}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Sub}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind VoidText}" Style="{StaticResource SecondaryTextStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind Voided}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Amount}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Button Tag="{x:Bind}" Click="Void_Click" Visibility="{x:Bind CanVoid}" ToolTipService.ToolTip="Bekor qilish" AutomationProperties.Name="Bekor qilish">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid>
                <TextBlock Text="{x:Bind ViewModel.PageText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Command="{x:Bind ViewModel.PrevCommand}" IsEnabled="{x:Bind ViewModel.CanPrev, Mode=OneWay}" AutomationProperties.Name="Oldingi sahifa">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.NextCommand}" IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" AutomationProperties.Name="Keyingi sahifa">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
