<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.SheetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels"
    xmlns:models="using:TisuEdu.Core.Models">
    <local:ViewPage.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_Invoked" />
    </local:ViewPage.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="8">
                <HyperlinkButton Padding="0" Command="{x:Bind ViewModel.OpenGroupCommand}">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                </HyperlinkButton>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.When, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource PillStyle}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind ViewModel.Cancelled, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.CancelledText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                    <Border Style="{StaticResource PillStyle}">
                        <TextBlock Text="{x:Bind ViewModel.MarkedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                    <HyperlinkButton Content="{x:Bind ViewModel.CancelActionText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleCancelCommand}"
                                     Visibility="{x:Bind ViewModel.CanCancel}" />
                </StackPanel>

                <controls:StatusBanner Model="{x:Bind ViewModel}" />

                <!-- Server tahrir oynasi: muddat o'tgan / bekor qilingan / boshlanmagan -->
                <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.HasWindowMessage, Mode=OneWay}" Message="{x:Bind ViewModel.WindowMessage, Mode=OneWay}" />

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Header="{x:Bind ViewModel.TopicLabel, Mode=OneWay}" Text="{x:Bind ViewModel.Topic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" />
                        <TextBox Grid.Column="1" Header="{x:Bind ViewModel.ReasonLabel, Mode=OneWay}" PlaceholderText="{x:Bind ViewModel.ReasonHint, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.DeadlineText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{x:Bind ViewModel.HasDeadline, Mode=OneWay}" />
                    </Grid>
                </Border>

                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SheetRowItem">
                            <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="160" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="4" Width="72" MaxLength="4" VerticalAlignment="Center" PlaceholderText="{x:Bind ScaleHint, Mode=OneWay}"
                                             ToolTipService.ToolTip="Darsdagi baho" AutomationProperties.Name="Baho"
                                             Text="{x:Bind Score, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind HasMarks, Mode=OneWay}"
                                             IsEnabled="{x:Bind CanMark, Mode=OneWay}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <ToggleButton Content="{x:Bind PresentLabel}" IsChecked="{x:Bind IsPresent, Mode=TwoWay}" IsEnabled="{x:Bind CanEdit}" MinWidth="76" />
                                        <ToggleButton Content="{x:Bind LateLabel}" IsChecked="{x:Bind IsLate, Mode=TwoWay}" IsEnabled="{x:Bind CanEdit}" MinWidth="76" />
                                        <ToggleButton Content="{x:Bind AbsentLabel}" IsChecked="{x:Bind IsAbsent, Mode=TwoWay}" IsEnabled="{x:Bind CanEdit}" MinWidth="76" />
                                        <ToggleButton Content="{x:Bind ExcusedLabel}" IsChecked="{x:Bind IsExcused, Mode=TwoWay}" IsEnabled="{x:Bind CanEdit}" MinWidth="76" />
                                    </StackPanel>
                                    <TextBox Grid.Column="2" Width="88" PlaceholderText="SS:DD" MaxLength="5" VerticalAlignment="Center"
                                             ToolTipService.ToolTip="Kelgan vaqt — holat avtomatik aniqlanadi"
                                             Text="{x:Bind Arrived, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind CanEdit}" />
                                    <TextBox Grid.Column="3" PlaceholderText="Izoh" MaxLength="255" VerticalAlignment="Center"
                                             Text="{x:Bind Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind CanEdit}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="O'zgarishlar tarixi" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,12,0,0"
                          Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryEntry">
                                <StackPanel Margin="0,0,0,12" Spacing="2">
                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Reason}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind HasReason}" />
                                    <TextBlock Text="{x:Bind Changes}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Padding="36,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                <Button Content="{x:Bind ViewModel.AllPresentText, Mode=OneWay}" Command="{x:Bind ViewModel.MarkRestPresentCommand}" />
                <Button Style="{StaticResource AccentButtonStyle}" MinWidth="140" Command="{x:Bind ViewModel.SaveCommand}"
                        ToolTipService.ToolTip="Ctrl+S">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.SaveText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</local:ViewPage>
