<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TisuEdu.App.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" Spacing="4" HorizontalAlignment="Left">
            <TextBlock Text="Ilova sozlamalari" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,12" />

            <TextBlock Text="Ko'rinish" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="20" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Mavzu" />
                        <TextBlock Text="Yorug', qorong'i yoki Windows sozlamasi bo'yicha" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" MinWidth="180" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" AutomationProperties.Name="Mavzu">
                        <ComboBoxItem Content="Windows sozlamasi" />
                        <ComboBoxItem Content="Yorug'" />
                        <ComboBoxItem Content="Qorong'i" />
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Text="Bildirishnomalar" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA8F;" FontSize="20" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Yangi e'lonlar" />
                        <TextBlock Text="Yangi yangilik yoki e'lon chiqqanda Windows bildirishnomasi" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" MinWidth="0" IsOn="{x:Bind ViewModel.Notifications, Mode=TwoWay}" AutomationProperties.Name="Bildirishnomalar" />
                </Grid>
            </Border>

            <TextBlock Text="Ilova haqida" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-48.png" Width="32" Height="32" />
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SiteName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"><Run Text="Versiya " /><Run Text="{x:Bind ViewModel.Version}" /></TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}"><Run Text="Server: " /><Run Text="{x:Bind ViewModel.Server}" /></TextBlock>
                    <HyperlinkButton Content="{x:Bind ViewModel.SiteUrl}" Command="{x:Bind ViewModel.OpenSiteCommand}" Padding="0" />
                    <TextBlock Text="Klaviatura: Ctrl+K — qidiruv, Ctrl+1…9 — bo'limlar, Alt+← yoki Esc — orqaga, F5 — yangilash, Ctrl+S — davomatni saqlash, Ctrl+Enter — testni topshirish, F1 — yordam."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
