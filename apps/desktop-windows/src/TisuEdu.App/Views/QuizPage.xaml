<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.QuizPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels"
    xmlns:models="using:TisuEdu.Core.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" Padding="{StaticResource PagePadding}" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.CourseTitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.Meta, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />

                <controls:StatusBanner Model="{x:Bind ViewModel}" Margin="0,8,0,0" />

                <!-- Umumiy ko'rinish -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsOverview, Mode=OneWay}">
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsStudent, Mode=OneWay}">
                        <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.NotAllowed, Mode=OneWay}" Message="{x:Bind ViewModel.NotAllowedText, Mode=OneWay}" />
                        <Button Style="{StaticResource AccentButtonStyle}" MinWidth="200" MinHeight="40" Command="{x:Bind ViewModel.StartCommand}"
                                Visibility="{x:Bind ViewModel.CanTake, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="{x:Bind ViewModel.StartText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Urinishlarim" Style="{StaticResource SectionHeaderStyle}" Visibility="{x:Bind ViewModel.HasAttempts, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Attempts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AttemptItem">
                                    <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,4">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind When}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Score}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind Passed}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Boshqaruvchi: savollar (javob kaliti) va natijalar -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsManager, Mode=OneWay}">
                        <CommandBar DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                            <AppBarButton Label="Sozlamalar" Command="{x:Bind ViewModel.EditQuizCommand}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Savol qo'shish" Command="{x:Bind ViewModel.AddQuestionCommand}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Label="Testni o'chirish" Command="{x:Bind ViewModel.DeleteQuizCommand}">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                        <TextBlock Text="Savollar" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="Hali savol qo'shilmagan." Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{x:Bind ViewModel.HasKeyQuestions, Mode=OneWay, Converter={StaticResource InverseVisibility}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.KeyQuestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:QuestionKeyItem">
                                    <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,4">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Meta}" Style="{StaticResource SecondaryTextStyle}" />
                                                <TextBlock Text="{x:Bind Answers}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" Visibility="{x:Bind CanEdit}">
                                                <Button Tag="{x:Bind}" Click="EditQuestion_Click" AutomationProperties.Name="Savolni tahrirlash">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                </Button>
                                                <Button Tag="{x:Bind}" Click="DeleteQuestion_Click" AutomationProperties.Name="Savolni o'chirish">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Natijalar" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="Hali hech kim topshirmagan." Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource InverseVisibility}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:QuizResultRow">
                                    <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,4">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind FullName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Phone}" Style="{StaticResource SecondaryTextStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ScoreText}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind PercentText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Natija -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}" Padding="24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ResultText, Mode=OneWay}" Style="{StaticResource BodyLargeTextBlockStyle}" />
                        <Button Content="{x:Bind ViewModel.BackText, Mode=OneWay}" Command="{x:Bind ViewModel.BackToOverviewCommand}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Savollar (topshirish va tekshiruv) -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Questions}" Visibility="{x:Bind ViewModel.ShowQuestions, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuestionItem">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Header}" Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Text="{x:Bind PointsText}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                                    <RadioButtons ItemsSource="{x:Bind Options}" SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                                                  Visibility="{x:Bind IsSingle}" IsEnabled="{x:Bind CanAnswer, Mode=OneWay}">
                                        <RadioButtons.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OptionItem">
                                                <RadioButton>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind IsCorrectAnswer, Mode=OneWay}" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </RadioButtons.ItemTemplate>
                                    </RadioButtons>

                                    <StackPanel Visibility="{x:Bind IsMultiple}" Spacing="4">
                                        <TextBlock Text="{x:Bind MultipleHint}" Style="{StaticResource SecondaryTextStyle}" />
                                        <ItemsControl ItemsSource="{x:Bind Options}" IsEnabled="{x:Bind CanAnswer, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OptionItem">
                                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind IsCorrectAnswer, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBox Visibility="{x:Bind IsText}" PlaceholderText="{x:Bind TextPlaceholder}" IsEnabled="{x:Bind CanAnswer, Mode=OneWay}"
                                             Text="{x:Bind TextAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <InfoBar IsClosable="False" IsOpen="{x:Bind IsReviewed, Mode=OneWay}" Message="{x:Bind ReviewText, Mode=OneWay}"
                                             Severity="{x:Bind local:QuizPage.ReviewSeverity(IsCorrect), Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Topshirish paneli: vaqt va tugma doim ko'rinadi -->
        <Border Grid.Row="1" Visibility="{x:Bind ViewModel.IsTaking, Mode=OneWay}" Padding="36,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid MaxWidth="900">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasTimer, Mode=OneWay}">
                    <FontIcon Glyph="&#xE916;" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.TimeLeft, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind ViewModel.TimeLow, Mode=OneWay}" />
                </StackPanel>
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" MinWidth="160" Command="{x:Bind ViewModel.SubmitCommand}"
                        Content="{x:Bind ViewModel.SubmitText, Mode=OneWay}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>
        </Border>
    </Grid>
</local:ViewPage>
