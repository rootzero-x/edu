<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.AttendancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels"
    xmlns:models="using:TisuEdu.Core.Models">
    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Davomati to'liq belgilanmagan o'tgan darslar" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <controls:StatusBanner Model="{x:Bind ViewModel}" />
            <InfoBar Severity="Success" IsClosable="False" IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" Message="Barcha darslar davomati belgilangan." />
        </StackPanel>
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Item_Click"
                  ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:UnmarkedItem">
                    <Border Style="{StaticResource ListCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Group}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind When}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Progress}" Style="{StaticResource SecondaryTextStyle}" />
                                <ProgressBar Value="{x:Bind Ratio}" Maximum="100" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</local:ViewPage>
