<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.BillingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
            <controls:StatusBanner Model="{x:Bind ViewModel}" />

            <!-- O'quvchi: o'z balansi -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsStudent, Mode=OneWay}">
                <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.IsDisabled, Mode=OneWay}" Message="To'lovlar hisobi hozircha o'chirilgan." />
                <Border Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Balans" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.MyBalance, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.MyInfo, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="So'nggi to'lovlar" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.MyEntries}">
                    <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EntryItem">
                    <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,4">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Date}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Type}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Sub}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind VoidText}" Style="{StaticResource SecondaryTextStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind Voided}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Amount}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Boshqaruvchi -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsManager, Mode=OneWay}">
                <GridView ItemsSource="{x:Bind ViewModel.Cards}" SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled" IsTabStop="False">
                    <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatCard">
                        <Grid Width="240" Height="96" Padding="16" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Top" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind Value}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Caption}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CalendarDatePicker Header="Hisobot: dan" Date="{x:Bind ViewModel.From, Mode=TwoWay}" DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}" />
                            <CalendarDatePicker Header="gacha" Date="{x:Bind ViewModel.To, Mode=TwoWay}" DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}" />
                            <Button VerticalAlignment="Bottom" Content="Ko'rsatish" Command="{x:Bind ViewModel.RefreshCommand}" />
                            <DropDownButton VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                    <TextBlock Text="CSV eksport" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="Balanslar (joriy filtr)" Command="{x:Bind ViewModel.ExportBalancesCommand}" />
                                        <MenuFlyoutItem Text="Davrdagi to'lov va tuzatishlar" Command="{x:Bind ViewModel.ExportEntriesCommand}" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ReportText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.MethodsText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Balanslar" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <AutoSuggestBox Width="280" PlaceholderText="Ism yoki telefon" QueryIcon="Find" QuerySubmitted="Search_QuerySubmitted"
                                    Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox x:Name="StatusBox" MinWidth="200" SelectedIndex="{x:Bind ViewModel.StatusIndex, Mode=TwoWay}" AutomationProperties.Name="Holat" />
                    <ComboBox x:Name="SortBox" MinWidth="200" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" AutomationProperties.Name="Tartib" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.Balances}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Balance_ItemClick"
                          ItemContainerStyle="{StaticResource CardListViewItemStyle}" ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BalanceItem">
                            <Border Style="{StaticResource ListCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Sub}" Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Text="{x:Bind LastPayment}" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind InDebt}" />
                                        <TextBlock Text="{x:Bind Balance}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.PageText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Command="{x:Bind ViewModel.PrevCommand}" IsEnabled="{x:Bind ViewModel.CanPrev, Mode=OneWay}" AutomationProperties.Name="Oldingi sahifa">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.NextCommand}" IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" AutomationProperties.Name="Keyingi sahifa">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
