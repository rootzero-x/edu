<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels">
    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <DropDownButton>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock Text="Import (Excel/CSV)" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Fayldan import qilish…" Command="{x:Bind ViewModel.ImportCommand}" />
                            <MenuFlyoutItem Text="Shablonni yuklab olish" Command="{x:Bind ViewModel.DownloadTemplateCommand}" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewUserCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                        <TextBlock Text="Yangi foydalanuvchi" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <AutoSuggestBox Width="300" PlaceholderText="Ism yoki telefon" QueryIcon="Find" QuerySubmitted="Search_QuerySubmitted"
                            Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox x:Name="RoleBox" MinWidth="180" SelectedIndex="{x:Bind ViewModel.RoleIndex, Mode=TwoWay}" />
            <ToggleSwitch OnContent="Tasdiqlanmaganlar" OffContent="Tasdiqlanmaganlar" IsOn="{x:Bind ViewModel.OnlyPending, Mode=TwoWay}" MinWidth="0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
            <controls:StatusBanner Model="{x:Bind ViewModel}" />
            <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.HasPending, Mode=OneWay}"
                     Message="Botdan ro'yxatdan o'tib, tasdiq kutayotgan foydalanuvchilar bor — «Tasdiqlanmaganlar» filtrini yoqing." />
            <TextBlock Text="Foydalanuvchi topilmadi." Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:UserItem">
                    <Border Style="{StaticResource ListCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Initials="{x:Bind Initials}" Width="40" Height="40" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Border Style="{StaticResource PillStyle}">
                                        <TextBlock Text="{x:Bind Role}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                    <Border Style="{StaticResource PillStyle}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind Blocked}">
                                        <TextBlock Text="bloklangan" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                    <Border Style="{StaticResource PillStyle}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind Pending}">
                                        <TextBlock Text="tasdiq kutmoqda" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Phone}" Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind Telegram}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="Tasdiqlash" Tag="{x:Bind}" Click="Approve_Click" Visibility="{x:Bind Pending}" Style="{StaticResource AccentButtonStyle}" />
                                <Button Tag="{x:Bind}" Click="Profile_Click" ToolTipService.ToolTip="Profil" AutomationProperties.Name="Profil">
                                    <FontIcon Glyph="&#xE77B;" FontSize="14" />
                                </Button>
                                <Button Tag="{x:Bind}" Click="Edit_Click" ToolTipService.ToolTip="Tahrirlash" AutomationProperties.Name="Tahrirlash">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                </Button>
                                <Button Tag="{x:Bind}" Click="Password_Click" ToolTipService.ToolTip="Parol o'rnatish" AutomationProperties.Name="Parol o'rnatish">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                </Button>
                                <Button Tag="{x:Bind}" Click="Block_Click" ToolTipService.ToolTip="Bloklash / blokdan chiqarish" AutomationProperties.Name="Bloklash">
                                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="4">
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Command="{x:Bind ViewModel.PrevCommand}" IsEnabled="{x:Bind ViewModel.CanPrev, Mode=OneWay}" AutomationProperties.Name="Oldingi sahifa">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button Command="{x:Bind ViewModel.NextCommand}" IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" AutomationProperties.Name="Keyingi sahifa">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</local:ViewPage>
