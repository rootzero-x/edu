<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.LeadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels">
    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Funnel, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewLeadCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Yangi ariza" />
                </StackPanel>
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox MinWidth="200" ItemsSource="{x:Bind ViewModel.StatusFilters}" SelectedIndex="{x:Bind ViewModel.StatusIndex, Mode=TwoWay}" AutomationProperties.Name="Holat" />
            <AutoSuggestBox Width="260" PlaceholderText="Ism yoki telefon" QueryIcon="Find" QuerySubmitted="Search_QuerySubmitted"
                            Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ToggleSwitch OnContent="Bugun bog'lanish kerak" OffContent="Bugun bog'lanish kerak" MinWidth="0" IsOn="{x:Bind ViewModel.DueOnly, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind ViewModel.DueText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
            <controls:StatusBanner Model="{x:Bind ViewModel}" />
            <TextBlock Text="Arizalar topilmadi." Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Item_Click"
                  ItemContainerStyle="{StaticResource CardListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LeadItem">
                    <Border Style="{StaticResource ListCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Border Style="{StaticResource PillStyle}">
                                        <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Phone}" Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind Sub}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind Comment}" Style="{StaticResource SecondaryTextStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind Due}" />
                                <TextBlock Text="{x:Bind Next}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="4">
            <TextBlock Text="{x:Bind ViewModel.PageText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Command="{x:Bind ViewModel.PrevCommand}" IsEnabled="{x:Bind ViewModel.CanPrev, Mode=OneWay}" AutomationProperties.Name="Oldingi sahifa">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button Command="{x:Bind ViewModel.NextCommand}" IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" AutomationProperties.Name="Keyingi sahifa">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</local:ViewPage>
