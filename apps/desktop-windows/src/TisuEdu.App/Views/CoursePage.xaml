<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.CoursePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels"
    xmlns:models="using:TisuEdu.Core.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap" />
                <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False"
                            Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <AppBarButton Label="Tahrirlash" Command="{x:Bind ViewModel.EditCourseCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Modul qo'shish" Command="{x:Bind ViewModel.AddModuleCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Yangi test" Command="{x:Bind ViewModel.NewQuizCommand}" Visibility="{x:Bind ViewModel.CanCreateQuiz, Mode=OneWay}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE9D5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton Label="Kursni o'chirish" Command="{x:Bind ViewModel.DeleteCourseCommand}">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Grid>
            <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind local:CoursePage.Not(ViewModel.IsPublished), Mode=OneWay}"
                     Message="Kurs chop etilmagan — o'quvchilarga ko'rinmaydi." Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />

            <controls:StatusBanner Model="{x:Bind ViewModel}" />

            <!-- Kursga kirish yo'q: matn API'dan (course.access_denied_* sozlamalari). -->
            <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.IsDenied, Mode=OneWay}"
                     Title="{x:Bind ViewModel.Denied.Title, Mode=OneWay}" Message="{x:Bind ViewModel.Denied.Message, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind ViewModel.Denied.Button, Mode=OneWay}" Command="{x:Bind ViewModel.ContactCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Pivot>
                <PivotItem Header="{x:Bind ViewModel.ModulesTitle, Mode=OneWay}">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.LessonsEmpty, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind ViewModel.NoLessons, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Modules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModuleItem">
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True" Margin="0,0,0,8">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="12" Padding="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind CanEdit}">
                                                    <Button Tag="{x:Bind}" Click="AddLesson_Click" ToolTipService.ToolTip="Dars qo'shish" AutomationProperties.Name="Dars qo'shish">
                                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                    </Button>
                                                    <Button Tag="{x:Bind}" Click="EditModule_Click" ToolTipService.ToolTip="Modulni tahrirlash" AutomationProperties.Name="Modulni tahrirlash">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                    </Button>
                                                    <Button Tag="{x:Bind}" Click="DeleteModule_Click" ToolTipService.ToolTip="Modulni o'chirish" AutomationProperties.Name="Modulni o'chirish">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                    </Button>
                                                </StackPanel>
                                                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                    <TextBlock Text="{x:Bind Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource SecondaryTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <ListView ItemsSource="{x:Bind Lessons}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Lesson_ItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LessonItem">
                                                    <Grid ColumnSpacing="12" Padding="0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Number}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        <FontIcon Grid.Column="2" Glyph="&#xED1A;" FontSize="14" Visibility="{x:Bind Hidden}"
                                                                  ToolTipService.ToolTip="Yashirin" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </PivotItem>
                <PivotItem Header="{x:Bind ViewModel.QuizzesTitle, Mode=OneWay}">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="{x:Bind ViewModel.QuizzesEmpty, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{x:Bind ViewModel.HasQuizzes, Mode=OneWay, Converter={StaticResource InverseVisibility}}" />
                        <ListView ItemsSource="{x:Bind ViewModel.Quizzes}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Quiz_ItemClick"
                                  ItemContainerStyle="{StaticResource CardListViewItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:QuizItem">
                                    <Border Style="{StaticResource ListCardStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE9D5;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <Border Style="{StaticResource PillStyle}" Visibility="{x:Bind IsFinal}">
                                                        <TextBlock Text="yakuniy" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Meta}" Style="{StaticResource SecondaryTextStyle}" />
                                                <TextBlock Text="{x:Bind Mine}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind HasMine}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind Passed}" />
                                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind Locked}" />
                                                <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
