<?xml version="1.0" encoding="utf-8"?>
<local:ViewPage
    x:Class="TisuEdu.App.Views.GroupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TisuEdu.App.Views"
    xmlns:controls="using:TisuEdu.App.Controls"
    xmlns:vm="using:TisuEdu.Core.ViewModels"
    xmlns:models="using:TisuEdu.Core.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Course, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            <CommandBar DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.CanManage}">
                <AppBarButton Label="Tahrirlash" Command="{x:Bind ViewModel.EditGroupCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="O'quvchi qo'shish" Command="{x:Bind ViewModel.AddMemberCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8FA;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Darslarni yaratish" Command="{x:Bind ViewModel.GenerateSessionsCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE787;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Sertifikatlar" Command="{x:Bind ViewModel.LoadCandidatesCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEB95;" /></AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Guruhni bitirish (hamma o'quvchilar)" Command="{x:Bind ViewModel.GraduateAllCommand}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE7BE;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <controls:StatusBanner Model="{x:Bind ViewModel}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="32" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TeacherLabel, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Teacher, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind ViewModel.WeeklyLabel, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Schedule, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Davr · Xona" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{x:Bind ViewModel.Period, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{x:Bind ViewModel.Room, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sertifikat berish: shartlar va natija -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasCandidates, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Sertifikat berish" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Content="Mos o'quvchilarga berish"
                                Command="{x:Bind ViewModel.IssueCertificatesCommand}" IsEnabled="{x:Bind ViewModel.CanIssue, Mode=OneWay}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CandidateItem">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Text="{x:Bind Meta}" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" MaxWidth="260" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.SessionsTitle, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}" />
                        <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Bottom" MinWidth="0" OnContent="Kelgusi" OffContent="O'tgan"
                                      IsOn="{x:Bind ViewModel.ShowUpcoming, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.SessionsEmpty, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay, Converter={StaticResource InverseVisibility}}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Sessions}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Session_ItemClick"
                              ItemContainerStyle="{StaticResource CardListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionItem">
                                <Border Style="{StaticResource ListCardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Width="56">
                                            <TextBlock Text="{x:Bind Weekday}" Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Text="{x:Bind Date}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Topic}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Style="{StaticResource PillStyle}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind Cancelled}">
                                                <TextBlock Text="{x:Bind CancelledText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </Border>
                                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind Incomplete}"
                                                      ToolTipService.ToolTip="Davomat to'liq belgilanmagan" />
                                            <TextBlock Text="{x:Bind Marked}" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind ViewModel.StudentsTitle, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StudentsEmpty, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind ViewModel.HasStudents, Mode=OneWay, Converter={StaticResource InverseVisibility}}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Students}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StudentRow">
                                <Border Style="{StaticResource ListCardStyle}" Margin="0,0,0,4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PersonPicture DisplayName="{x:Bind Name}" Width="32" Height="32" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <HyperlinkButton Content="{x:Bind Name}" Tag="{x:Bind}" Click="Profile_Click" Padding="0" IsEnabled="{x:Bind CanOpenProfile}" />
                                                <Border Style="{StaticResource PillStyle}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind Frozen}">
                                                    <TextBlock Text="muzlatilgan" Style="{StaticResource CaptionTextBlockStyle}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Text="{x:Bind Phone}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind HasPhone}" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind Counts}" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <StackPanel Width="72" Visibility="{x:Bind HasRate}">
                                                <TextBlock Text="{x:Bind Rate}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
                                                <ProgressBar Value="{x:Bind RateValue}" Maximum="100" />
                                            </StackPanel>
                                            <Button Tag="{x:Bind}" Click="ManageMember_Click" Visibility="{x:Bind CanManage}" ToolTipService.ToolTip="Muzlatish, o'tkazish, bitirish, chiqarish"
                                                    AutomationProperties.Name="O'quvchi amallari">
                                                <FontIcon Glyph="&#xE712;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Sobiq a'zolar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,0"
                              Visibility="{x:Bind ViewModel.HasFormer, Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Former}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" Style="{StaticResource SecondaryTextStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</local:ViewPage>
