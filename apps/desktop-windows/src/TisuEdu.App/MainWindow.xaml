<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TisuEdu.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Oyna sarlavhasi (title bar) — tizim tugmalari o'ng tomonda Windows tomonidan chiziladi. -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Width="18" Height="18" />
                <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Text="TISU Edu" />
                <Border x:Name="OfflinePill" Visibility="Collapsed" Style="{StaticResource PillStyle}"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xF384;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="Oflayn" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" IsNavigationStackEnabled="False" />

        <InfoBar x:Name="FatalBar" Grid.Row="1" Severity="Error" IsOpen="False" IsClosable="True"
                 Title="Xatolik" VerticalAlignment="Bottom" Margin="24" MaxWidth="720" />
    </Grid>
</Window>
